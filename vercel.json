{
  "version": 2,
  "builds": [
    {
      "src": "giftlink-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "giftlink-backend/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "giftlink-backend/app.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "giftlink-backend/app.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "giftlink-frontend/index.html"
    }
  ]
}
